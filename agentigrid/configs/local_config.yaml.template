# AgentiGrid Local Configuration Template
# Copy this file to local_config.yaml and adjust values for your setup:
#   cp local_config.yaml.template local_config.yaml
# Usage: agentigrid --config configs/local_config.yaml ./data/exago/examples/case_ACTIVSg200.m "your goal"

# ExaGO settings
exago:
  binary_dir: "./applications/exago"
  env_script: "./configs/env_setup.sh"
  timeout: 120

# Data settings
data:
  data_dir: "./data/exago"

# LLM backend settings — adjust for your provider
llm:
  backend: "ollama"                    # openai | anthropic | ollama | ollama-cloud
  model: "qwen2.5:7b"                 # model name for your backend
  api_key_env: "ANTHROPIC_API_KEY"     # env var name (unused for local Ollama)
  ollama_host: "http://localhost:11434"
  # ollama_cloud_host: null            # set for Ollama Cloud
  temperature: 0.3
  max_tokens: 4096

# Search settings
search:
  max_iterations: 10
  default_mode: "fresh"
  application: "opflow"

# Output settings
output:
  workdir: "./workdir"
  logs_dir: "./logs"
  save_journal: true
  journal_format: "json"
  save_modified_files: true
  verbose: true

# GridKit settings (used with --tool gridkit). LLM, iteration limit, worker
# count and output folders come from the sections above; GridKit output goes
# to {output.workdir}/gridkit/ and {output.logs_dir}/gridkit/.
# PJM pass/fail limits are not set here: they are fixed in
# agentigrid/gridkit_engine/criteria.py with their sources.
gridkit:
  binary_dir: "./applications/gridkit"  # links to GridKit/build/bin
  dynamicsimulation_binary: null        # defaults to {binary_dir}/DynamicSimulation
  timeout: 600                          # seconds per GridKit run

  # Written into each run's solver .json; keys are GridKit's own
  # (GridKit/application/PhasorDynamics/README.md)
  study:
    tmax: 15.0                          # simulation length, s (PJM: 10-15 s; damping needs >= 10)
    dt_monitor: 0.01                    # recording interval, s
    rel_tol: 1.0e-7
    abs_tol: 1.0e-9
    dt_fixed: 0.0                       # 0 = adaptive time step
    max_steps: 0                        # 0 = IDA default, negative = unlimited
    max_order: 5                        # IDA method order, 1-5

  fault:                                # used when the goal gives no time
    start: 1.0                          # fault_on time, s; the clearing time follows
                                        #   PJM clearing cycles + margin (criteria.py)
