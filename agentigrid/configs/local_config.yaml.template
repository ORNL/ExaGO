# AgentiGrid Local Configuration Template
# Copy this file to local_config.yaml and adjust values for your setup:
#   cp local_config.yaml.template local_config.yaml
# Usage: agentigrid --config configs/local_config.yaml ./data/exago/examples/case_ACTIVSg200.m "your goal"

# ExaGO settings
exago:
  binary_dir: "./applications/exago"
  env_script: "./configs/env_setup.sh"
  timeout: 120
  # Solved cases written by OPFLOW/PFLOW (opflowout.m / pflowout.m) in each run folder:
  #   all     keep every one
  #   best    single solves kept; a multi-solve action (sweep, explore, boundary,
  #           contingency, reserve) keeps only its best, or the most recent if it has no best
  #   newest  single solves kept; a multi-solve action keeps only its most recent
  #   none    not written (GridKit cannot start from the latest ExaGO steady state)
  save_solutions: "best"

# Data settings
data:
  data_dir: "./data/exago"

# LLM backend settings — adjust for your provider
llm:
  backend: "ollama"                    # openai | anthropic | ollama | ollama-cloud
  model: "qwen2.5:7b"                 # model name for your backend
  api_key_env: "ANTHROPIC_API_KEY"     # env var name (unused for local Ollama)
  ollama_host: "http://localhost:11434"
  # ollama_cloud_host: null            # set for Ollama Cloud
  temperature: 0.3                     # null: not sent (some reasoning models reject it)
  max_tokens: 4096
  # reasoning_effort: "medium"         # openai/Gemini: reasoning_effort; ollama: think ("none" = off)
  # Retries of transient API errors (HTTP 5xx, timeouts, connection errors, 429 rate
  # limits that are not quota exhaustion), logged in the journal. Quota exhaustion is not
  # retried (session ends "quota_exhausted", exit 4); other API errors end it "api_error" (exit 3).
  retry:
    max_retries: 5
    backoff_s: [10, 30, 60, 120, 240]   # wait before retry 1, 2, ...; the last value repeats
  # Gemini via Google's OpenAI-compatible endpoint
  # backend: "openai"
  # model: "gemini-3.8-flash"
  # openai_base_url: "https://generativelanguage.googleapis.com/v1beta/openai/"
  # api_key_env: "GEMINI_API_KEY"
  # reasoning_effort: "medium"

# Search settings
search:
  max_iterations: 10
  default_mode: "fresh"
  application: "opflow"

# Output settings
output:
  workdir: "./workdir"
  logs_dir: "./logs"
  save_journal: true
  journal_format: "json"
  save_modified_files: true
  verbose: true

# GridKit settings (used with --tool gridkit). LLM, iteration limit, worker
# count and output folders come from the sections above; GridKit output goes
# to {output.workdir}/gridkit/ and {output.logs_dir}/gridkit/.
# PJM pass/fail limits are not set here: they are fixed in
# agentigrid/gridkit_engine/criteria.py with their sources.
gridkit:
  binary_dir: "./applications/gridkit"  # links to GridKit/build/bin
  dynamicsimulation_binary: null        # defaults to {binary_dir}/DynamicSimulation
  timeout: 600                          # seconds per GridKit run
  threads: 1                            # OPENBLAS_NUM_THREADS/OMP_NUM_THREADS per run (runs go
                                        #   in parallel); null = leave the environment as is
  damping_in_verdict: true              # false: damping is computed and reported as "info" only,
                                        #   outside the verdict (peak-decay estimate unreliable on
                                        #   multi-mode responses)

  # Written into each run's solver .json; keys are GridKit's own
  # (GridKit/application/PhasorDynamics/README.md)
  study:
    tmax: 15.0                          # simulation length, s (PJM: 10-15 s; damping needs >= 10)
    dt_monitor: 0.01                    # recording interval, s
    rel_tol: 1.0e-7
    abs_tol: 1.0e-9
    dt_fixed: 0.0                       # 0 = adaptive time step
    max_steps: 0                        # 0 = IDA default, negative = unlimited
    max_order: 5                        # IDA method order, 1-5

  fault:                                # used when the goal gives no time
    start: 1.0                          # fault_on time, s; the clearing time follows
                                        #   PJM clearing cycles + margin (criteria.py)
