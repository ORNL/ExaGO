# =============================================================================
# AgentiGrid runtime artifacts
# =============================================================================
workdir/
logs/
configs/logs/
*.log
.env
.env.*
!.env.example

# =============================================================================
# Local binaries and data (large, machine-specific)
# Available via the ExaGO build and datafiles/ at the ExaGO root.
# Only the README explaining what goes here is tracked.
# =============================================================================
applications/*
!applications/README.md
!applications/exago/
!applications/gridkit/
applications/exago/*
applications/gridkit/*
!applications/exago/README.md
!applications/gridkit/README.md
data/*
!data/README.md
!data/exago/
!data/gridkit/
data/exago/*
data/gridkit/*
!data/exago/README.md
!data/gridkit/README.md
!data/exago/datafiles/
!data/gridkit/datafiles/
data/exago/datafiles/*
data/gridkit/datafiles/*
!data/exago/datafiles/README.md
!data/gridkit/datafiles/README.md
_sopflow_probe/

# =============================================================================
# Local config files (templates are tracked, instantiated copies are local)
# =============================================================================
configs/env_setup.sh
configs/local_config.yaml
configs/default_config.yaml

# =============================================================================
# IDE / editor
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*.bak
*~

# =============================================================================
# OS-generated files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Developer scratch space (AI coding tools, personal notes, working prompts)
# These live in the working tree but never get committed.
# =============================================================================
.claude/
.opencode/
AGENTS.md
opencode.md
/prompts/

# RAG index (build locally: python -m agentigrid.rag.ingest rag/corpus)
rag/store/
rag/store_*/
