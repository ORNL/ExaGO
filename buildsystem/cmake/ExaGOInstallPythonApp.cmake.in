cmake_policy(PUSH)
cmake_policy(VERSION 3.18)

foreach(dir BINDIR LIBEXECDIR DATADIR)
  if(dir STREQUAL "BINDIR")
    set(value "@CMAKE_INSTALL_BINDIR@")
  elseif(dir STREQUAL "LIBEXECDIR")
    set(value "@EXAGO_INSTALL_LIBEXECDIR@")
  else()
    set(value "@EXAGO_INSTALL_DATADIR@")
  endif()
  if(NOT IS_ABSOLUTE "${value}")
    set(value "${CMAKE_INSTALL_PREFIX}/${value}")
  endif()
  set(EXAGO_${dir} "${value}")
endforeach()
set(EXAGO_APP_DIR "${EXAGO_LIBEXECDIR}/@EXAGO_PYTHON_APP@")
set(EXAGO_APP_DATA_DIR "${EXAGO_DATADIR}/@EXAGO_PYTHON_APP@")
set(EXAGO_VENV_DIR "${EXAGO_APP_DIR}/venv")
set(EXAGO_VENV_STAGE "$ENV{DESTDIR}${EXAGO_VENV_DIR}")
set(EXAGO_PYTHON_APP_SOURCE "@EXAGO_PYTHON_APP_SOURCE@")
set(IPOPT_ROOT_DIR "@IPOPT_ROOT_DIR@")
set(PETSC_DIR "@PETSC_DIR@")
set(EXAGO_PYTHON_SITELIB "@EXAGO_PYTHON_SITELIB@")
if(NOT IS_ABSOLUTE "${EXAGO_PYTHON_SITELIB}")
  set(EXAGO_PYTHON_SITELIB "${CMAKE_INSTALL_PREFIX}/${EXAGO_PYTHON_SITELIB}")
endif()

set(venv_args)
if(NOT @EXAGO_INSTALL_PYTHON_DEPENDENCIES@)
  list(APPEND venv_args --without-pip)
endif()
execute_process(COMMAND "@Python_EXECUTABLE@" -m venv ${venv_args}
                "${EXAGO_VENV_STAGE}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Failed to create ${EXAGO_VENV_STAGE}")
endif()
if(@EXAGO_INSTALL_PYTHON_DEPENDENCIES@)
  set(requirement_args)
  foreach(requirement IN ITEMS @EXAGO_PYTHON_APP_REQUIREMENTS@)
    list(APPEND requirement_args -r "${requirement}")
  endforeach()
  execute_process(COMMAND "${EXAGO_VENV_STAGE}/bin/python" -m pip install
                  --ignore-installed ${requirement_args} RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to install @EXAGO_PYTHON_APP@ dependencies")
  endif()
endif()

# remove the packaging staging prefix after we're done setting up the venv
if(NOT "$ENV{DESTDIR}" STREQUAL "")
  file(GLOB scripts "${EXAGO_VENV_STAGE}/bin/*")
  foreach(script IN LISTS scripts)
    if(NOT IS_SYMLINK "${script}" AND NOT IS_DIRECTORY "${script}")
      file(READ "${script}" magic LIMIT 2)
      get_filename_component(name "${script}" NAME)
      if(NOT magic STREQUAL "#!" AND NOT name MATCHES "^[Aa]ctivate")
        continue()
      endif()
      file(READ "${script}" content)
      string(REPLACE "${EXAGO_VENV_STAGE}" "${EXAGO_VENV_DIR}" content "${content}")
      file(WRITE "${script}" "${content}")
    endif()
  endforeach()
endif()

macro(exago_configure_install input destination)
  configure_file("${input}" "$ENV{DESTDIR}${destination}" @ONLY)
  list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${destination}")
endmacro()
macro(exago_install_launcher template name)
  exago_configure_install("${EXAGO_PYTHON_APP_SOURCE}/${template}"
                         "${EXAGO_BINDIR}/${name}")
  file(CHMOD "$ENV{DESTDIR}${EXAGO_BINDIR}/${name}"
       PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                   GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endmacro()

cmake_policy(POP)
