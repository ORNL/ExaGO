#!/usr/bin/env bash
set -e
if [ -n "@LAUNCH_VENV_DIR@" ]; then
    source "@LAUNCH_VENV_DIR@/bin/activate"
fi
export EXAGO_STATE_DIR="${EXAGO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/exago}"
exec "@LAUNCH_PYTHON@" -m streamlit run "@LAUNCH_EXAGO_LAUNCHER_DIR@/app.py" "$@" -- --config "${EXAGO_LAUNCHER_CONFIG:-@LAUNCH_CONFIG@}"
